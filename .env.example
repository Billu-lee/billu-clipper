GEMINI_API_KEY=your_key_here

# Optional YouTube publishing: Google Cloud OAuth client (Web application).
# Must exactly match the authorized redirect URI in Google Cloud and Flask port.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:5001/accounts/youtube/callback

# Optional Instagram: Facebook Login for Business token, Page-linked professional account.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# Optional stable random session secret (keep private).
FLASK_SECRET_KEY=
